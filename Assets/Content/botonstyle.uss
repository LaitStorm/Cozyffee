:root {
}

.botonstyle {
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Examples%20&%20Extras/Fonts/Roboto-Bold.ttf?fileID=12800000&guid=4beb055f07aaff244873dec698d0363e&type=3#Roboto-Bold");
    -unity-font-style: normal;
    font-size: 18px;
    align-self: center;
    align-items: center;
    -unity-text-align: middle-center;
    background-color: rgb(216, 190, 224);
    border-left-color: rgb(55, 55, 55);
    border-right-color: rgb(55, 55, 55);
    border-top-color: rgb(55, 55, 55);
    border-bottom-color: rgb(55, 55, 55);
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: 15px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    aspect-ratio: auto;
    transition-duration: 0s;
    justify-content: flex-start;
    color: rgb(255, 250, 250);
    background-size: 100% 100%;
    align-content: stretch;
    flex-wrap: wrap;
    flex-direction: column;
}

.botonstyle:hover {
    scale: 1.03 1.03 1.03;
    background-color: rgb(235, 123, 192);
    transition-duration: 0s;
}

.unity-base-slider__tracker {
    background-color: rgb(216, 190, 224);
    border-left-color: rgb(216, 190, 224);
    border-right-color: rgb(216, 190, 224);
    border-top-color: rgb(216, 190, 224);
    border-bottom-color: rgb(216, 190, 224);
    justify-content: center;
    padding-bottom: 2px;
    padding-top: 2px;
}

.unity-base-slider__dragger {
    background-color: rgb(255, 255, 255);
    border-left-color: rgb(235, 123, 192);
    border-right-color: rgb(235, 123, 192);
    border-top-color: rgb(235, 123, 192);
    border-bottom-color: rgb(235, 123, 192);
}

#unity-fill {
    background-color: rgb(235, 123, 192);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-left-color: rgb(255, 102, 102);
    border-right-color: rgb(255, 102, 102);
    border-top-color: rgb(255, 102, 102);
    border-bottom-color: rgb(255, 102, 102);
}

#unity-tracker {
    -unity-text-outline-color: rgb(210, 38, 38);
    background-color: rgb(216, 190, 224);
    border-left-color: rgb(235, 123, 192);
    border-right-color: rgb(235, 123, 192);
    border-top-color: rgb(235, 123, 192);
    border-bottom-color: rgb(235, 123, 192);
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: 15px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
}

.unity-toggle__label {
    -unity-text-align: middle-left;
}

.unity-toggle__checkmark {
    color: rgb(255, 255, 255);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    background-color: rgb(255, 255, 255);
}

/* Slider de cantidad de NPCs (Configuración): esquinas redondeadas en la barra, el relleno y la manija */
#Slider_npcs #unity-tracker {
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: 15px;
}

#Slider_npcs #unity-fill {
    border-top-left-radius: 13px;
    border-top-right-radius: 13px;
    border-bottom-right-radius: 13px;
    border-bottom-left-radius: 13px;
}

#Slider_npcs .unity-base-slider__dragger {
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
}

/* Panel de Configuración: todas las etiquetas a la izquierda y del mismo ancho, así los controles quedan alineados
   y caben dentro del panel. */
.config-panel .unity-base-field__label {
    width: 120px;
    min-width: 120px;
    max-width: 120px;
    margin-left: 0;
    padding-left: 0;
    -unity-text-align: middle-left;
    white-space: normal;
}

/* El interruptor de Snap turn: más angosto para que quepa al lado de su etiqueta */
#Toggle_snap_turn #unity-checkmark {
    min-width: 110px;
}
