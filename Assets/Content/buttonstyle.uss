:root {
}

.buttonstyle {
    transition-duration: 0.5s;
    background-color: rgb(240, 211, 248);
    border-left-color: rgb(83, 83, 83);
    border-right-color: rgb(83, 83, 83);
    border-top-color: rgb(83, 83, 83);
    border-bottom-color: rgb(83, 83, 83);
    font-size: 20px;
    color: rgb(255, 250, 250);
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: 15px;
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Examples%20&%20Extras/Fonts/Electronic%20Highway%20Sign.TTF?fileID=12800000&guid=8a2b9e2a607dd2143b58c44bc32410b4&type=3#Electronic Highway Sign");
    -unity-font-style: bold;
    margin-left: 0;
    padding-top: 12px;
    padding-right: 12px;
    padding-bottom: 12px;
    padding-left: 12px;
    -unity-text-align: middle-left;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.buttonstyle:hover {
    background-color: rgb(220, 115, 180);
    scale: 1.03 1.03 1.03;
    -unity-background-image-tint-color: rgb(76, 76, 76);
}
