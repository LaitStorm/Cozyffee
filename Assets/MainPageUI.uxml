<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Content/buttonstyle.uss?fileID=7433441132597879392&amp;guid=ab1b40c2dc06bdb4dade001c920aba56&amp;type=3#buttonstyle"/>
    <ui:VisualElement name="VisualElement" style="flex-grow: 1; background-image: none; background-color: rgb(255, 240, 228); justify-content: center; align-self: center; width: 679px;">
        <ui:Label text="Bienvenidx a" style="justify-content: flex-start; align-self: center; align-content: center; align-items: center; margin-top: 30px; margin-right: 2px; -unity-font-definition: url(&quot;project://database/Assets/Samples/XR%20Interaction%20Toolkit/3.6.1/World%20Space%20UI/Styles/XRIDefaultRuntimeTheme.tss?fileID=2230732570650464555&amp;guid=511976cd788ea5442a20b479849b0cef&amp;type=3#NotInter-Regular&quot;); -unity-font-style: bold; font-size: 20px; color: rgb(220, 115, 180); margin-bottom: -5px; white-space: pre; -unity-text-align: lower-left;"/>
        <ui:VisualElement style="flex-grow: 2.5; background-image: url(&quot;project://database/Assets/Cozyffee_logo.png?fileID=2800000&amp;guid=258255093ce57c54c91424fdc3b00ca2&amp;type=3#Cozyffee_logo&quot;); margin-top: 0; margin-right: 5px; margin-bottom: -5px; margin-left: 5px; padding-top: 0; padding-right: 5px; padding-bottom: 0; padding-left: 5px; max-width: none; min-width: initial; min-height: initial; max-height: none; flex-wrap: nowrap; align-items: center; justify-content: space-between;"/>
        <ui:Label text="Felicidades! Te has vuelto dueñx de tu propia cafetería/heladería!&#10;Tu objetivo es atender los pedidos de los &#10;hambrientos clientes que van llegando al establecimiento.&#10;Si te demoras mucho tiempo en atenderlos, los clientes se pondrán tristes porque pensarán que olvidaste su órden :c&#10;No hay límites de tiempo! &#10;Solo relájate y disfruta de manejar tu propia cafetería cozy " emoji-fallback-support="false" style="height: 163px; background-color: rgb(255, 240, 228); align-items: auto; align-self: center; justify-content: center; flex-wrap: wrap; align-content: auto; -unity-text-align: middle-center; color: rgb(220, 115, 180); font-size: 18px; -unity-font-style: bold; white-space: pre-wrap; margin-top: 0; margin-right: 25px; margin-bottom: 10px; margin-left: 25px; padding-right: 4px; padding-left: 4px; width: 649px; text-overflow: clip; padding-top: 0; padding-bottom: 0;"/>
        <ui:VisualElement name="VisualElement" style="flex-grow: 0.2; background-color: rgba(255, 255, 255, 0); justify-content: space-around; margin-top: 0; margin-right: 40px; margin-bottom: 20px; margin-left: 40px; align-self: center; align-items: center; padding-bottom: 0; padding-top: 0; transform-origin: top; translate: 0 0; flex-wrap: wrap; flex-shrink: initial;">
            <ui:Button text="Comenzar tutorial" double-click-selects-word="false" name="tutorial_boton" class="buttonstyle" style="border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; font-size: 20px; color: rgb(255, 250, 250);"/>
            <ui:Button text="Iniciar juego" name="Inicio_boton" class="buttonstyle"/>
            <ui:Button text="Salir" name="Salir_boton" class="buttonstyle"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
