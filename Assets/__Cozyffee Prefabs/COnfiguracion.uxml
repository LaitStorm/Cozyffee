<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Content/botonstyle.uss?fileID=7433441132597879392&amp;guid=55ebbfdc5fef8de4c87a24497ae540ca&amp;type=3#botonstyle"/>
    <engine:VisualElement xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" template="XRIModalButtonDocument" name="VisualElement" style="height: 468px; background-color: rgb(32, 32, 32); border-left-color: rgb(234, 123, 191); border-right-color: rgb(234, 123, 191); border-top-color: rgb(234, 123, 191); border-bottom-color: rgb(234, 123, 191); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px;">
        <Style src="project://database/Assets/Samples/XR%20Interaction%20Toolkit/3.6.1/World%20Space%20UI/Styles/XRIStyleSheet.uss?fileID=7433441132597879392&amp;guid=3245a7d03283da54db4385c49204e816&amp;type=3#XRIStyleSheet"/>
        <engine:VisualElement name="VisualElement" class="config-panel" style="flex-grow: 1; background-color: rgb(255, 240, 228); color: rgb(255, 255, 255); padding-left: 10px; padding-top: 0; padding-right: 10px; padding-bottom: 10px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; border-left-color: rgb(234, 123, 191); border-right-color: rgb(234, 123, 191); border-top-color: rgb(234, 123, 191); border-bottom-color: rgb(234, 123, 191); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px;">
            <engine:Label text="Configuración" style="font-size: 22px; -unity-text-align: upper-center; -unity-font-style: bold; margin-top: 10px; padding-top: 10px; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Examples%20&amp;%20Extras/Fonts/Electronic%20Highway%20Sign.TTF?fileID=12800000&amp;guid=8a2b9e2a607dd2143b58c44bc32410b4&amp;type=3#Electronic Highway Sign&quot;); color: rgb(234, 123, 191);"/>
            <engine:Slider label="Volumen ambiente" value="0.8" high-value="1" name="Slider_ambiente" fill="true" style="color: rgb(234, 123, 191); -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Examples%20&amp;%20Extras/Fonts/Unity.ttf?fileID=12800000&amp;guid=f4eec857a4fdf2f43be0e9f3d1a984e7&amp;type=3#Unity&quot;); -unity-font-style: bold; font-size: 16px; -unity-text-align: middle-left;"/>
            <engine:Slider label="Volumen SFX" value="42" high-value="1" name="Slider_sfx" fill="true" style="color: rgb(235, 131, 193); -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Examples%20&amp;%20Extras/Fonts/Unity.ttf?fileID=12800000&amp;guid=f4eec857a4fdf2f43be0e9f3d1a984e7&amp;type=3#Unity&quot;); -unity-font-style: bold; font-size: 16px; -unity-text-align: middle-left;"/>
            <engine:VisualElement name="Fila_npcs" style="flex-direction: row; align-items: center;">
                <engine:SliderInt label="Número NPCs" value="15" high-value="20" name="Slider_npcs" fill="true" style="color: rgb(234, 123, 191); -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Examples%20&amp;%20Extras/Fonts/Unity.ttf?fileID=12800000&amp;guid=f4eec857a4fdf2f43be0e9f3d1a984e7&amp;type=3#Unity&quot;); -unity-font-style: bold; font-size: 16px; -unity-text-align: middle-left; flex-grow: 1; margin-right: 4px;"/>
                <engine:Label text="15" name="Label_npcs_valor" style="width: 28px; color: rgb(234, 123, 191); -unity-font-style: bold; font-size: 16px; -unity-text-align: middle-right; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Examples%20&amp;%20Extras/Fonts/Unity.ttf?fileID=12800000&amp;guid=f4eec857a4fdf2f43be0e9f3d1a984e7&amp;type=3#Unity&quot;);"/>
            </engine:VisualElement>
            <engine:Toggle label="Activar Snap turn" name="Toggle_snap_turn" value="false" text="Off" toggle-on-label-click="true" style="color: rgb(234, 123, 191); -unity-text-align: middle-left; -unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Library/unity%20default%20resources?fileID=10102&amp;guid=0000000000000000e000000000000000&amp;type=0#LegacyRuntime&quot;); justify-content: flex-start; flex-wrap: wrap; height: 60px; border-left-color: rgba(0, 0, 0, 0); border-right-color: rgba(0, 0, 0, 0); border-top-color: rgba(0, 0, 0, 0); border-bottom-color: rgba(0, 0, 0, 0);"/>
            <engine:VisualElement style="flex-grow: 1; justify-content: space-between; align-self: center; align-items: flex-start; flex-direction: column; padding-top: 10px;">
                <engine:Button text="Volver al menú" name="Boton_volver_menu" class="botonstyle" style="height: 61px; padding-top: 6px; padding-bottom: 6px; -unity-text-align: middle-center; white-space: pre; text-overflow: clip;"/>
            </engine:VisualElement>
        </engine:VisualElement>
    </engine:VisualElement>
</ui:UXML>
