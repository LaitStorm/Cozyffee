<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Content/botonstyle.uss?fileID=7433441132597879392&amp;guid=55ebbfdc5fef8de4c87a24497ae540ca&amp;type=3#botonstyle"/>
    <engine:VisualElement xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" template="XRIModalButtonDocument" name="VisualElement" style="height: 468px; background-color: rgb(32, 32, 32); border-left-color: rgb(234, 123, 191); border-right-color: rgb(234, 123, 191); border-top-color: rgb(234, 123, 191); border-bottom-color: rgb(234, 123, 191); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px;">
        <Style src="project://database/Assets/Samples/XR%20Interaction%20Toolkit/3.6.1/World%20Space%20UI/Styles/XRIStyleSheet.uss?fileID=7433441132597879392&amp;guid=3245a7d03283da54db4385c49204e816&amp;type=3#XRIStyleSheet"/>
        <engine:VisualElement name="VisualElement" style="flex-grow: 1; background-color: rgb(255, 240, 228); color: rgb(255, 255, 255); padding-left: 10px; padding-top: 0; padding-right: 10px; padding-bottom: 10px; border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px; border-left-color: rgb(234, 123, 191); border-right-color: rgb(234, 123, 191); border-top-color: rgb(234, 123, 191); border-bottom-color: rgb(234, 123, 191); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px;">
            <engine:Image style="background-image: url(&quot;project://database/Assets/__Cozyffee%20Prefabs/Cozyffee_logo.png?fileID=2800000&amp;guid=7feeaf6914a89ea44aceb7ed1576c85c&amp;type=3#Cozyffee_logo&quot;); height: 58px; width: 254px; margin-top: 10px; align-self: center;"/>
            <engine:Label text="Menu " style="font-size: 22px; -unity-text-align: upper-center; -unity-font-style: bold; margin-top: 0; padding-top: 0; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Examples%20&amp;%20Extras/Fonts/Electronic%20Highway%20Sign.TTF?fileID=12800000&amp;guid=8a2b9e2a607dd2143b58c44bc32410b4&amp;type=3#Electronic Highway Sign&quot;); color: rgb(234, 123, 191);"/>
            <engine:VisualElement style="flex-grow: 1; justify-content: space-between; align-self: center; align-items: flex-start; flex-direction: column;">
                <engine:Button text="Iniciar tutorial" name="Boton_tutorial" class="botonstyle" style="-unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Examples%20&amp;%20Extras/Fonts/Roboto-Bold.ttf?fileID=12800000&amp;guid=4beb055f07aaff244873dec698d0363e&amp;type=3#Roboto-Bold&quot;); padding-top: 6px; padding-bottom: 6px; justify-content: flex-start;"/>
                <engine:Button text="Configuraciones" name="Boton_config" class="botonstyle" style="padding-top: 6px; padding-bottom: 6px;"/>
                <engine:Button text="Volver al juego" name="Boton_volver" class="botonstyle" style="height: 61px; padding-top: 6px; padding-bottom: 6px;"/>
                <engine:Button text="Salir" name="Boton_salir" class="botonstyle" style="padding-top: 6px; padding-bottom: 6px;"/>
            </engine:VisualElement>
        </engine:VisualElement>
    </engine:VisualElement>
</ui:UXML>
